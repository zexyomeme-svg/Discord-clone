# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Flask/Render sets PORT automatically in production.
PORT=8000

# Signing key for the one-time OAuth2 handoff cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, run.py generates a key and persists it to .flask_secret_key
# (gitignored). Set this explicitly on any host with an ephemeral filesystem.
SECRET_KEY=

# Only set to 1 for local debugging. Never enable this in production.
FLASK_DEBUG=0

# ---------------------------------------------------------------------------
# Discord API proxy
# ---------------------------------------------------------------------------
# Upstream Discord REST API base URL.
DISCORD_API_BASE=https://discord.com/api/v10

# Comma-separated origins allowed to call /api/* cross-origin.
# EMPTY (the default) means same-origin only, which is what this app needs.
# Only set this if you host the frontend on a different origin. "*" is accepted
# but turns the deployment into an open relay for Discord API traffic.
CORS_ORIGINS=

# Upstream request timeout in seconds.
PROXY_TIMEOUT=30

# Maximum request body the proxy will buffer, in MB. Discord allows 25 MB of
# attachments per message for bots; 32 MB leaves room for the multipart envelope.
MAX_UPLOAD_MB=32

# Bot-style User-Agent used by the proxy. Discord/Cloudflare can reject Bot API
# calls that look like browser traffic (error code 40333), so do not use a
# browser User-Agent here.
DISCORD_USER_AGENT=DiscordBot (https://github.com/zexyomeme-svg/Discord-clone, 1.0)

# ---------------------------------------------------------------------------
# Frontend build
# ---------------------------------------------------------------------------
# Set to 0 to stop automatic frontend install/build when dist/ is missing.
AUTO_BUILD_FRONTEND=1

# Set to 0 so run.py does not spawn build_frontend.py in the background.
# When enabled (default) the web server starts immediately and the build runs
# off-thread.
BACKGROUND_BUILD=1

# Run the light file/tool checks on startup even when dist/ already exists.
# Off by default so a multi-worker Gunicorn boot does not spawn a subprocess per
# worker.
RUN_STARTUP_CHECKS=0

# Node version used by nodeenv if system Node/npm is unavailable. Node 20 reached
# end-of-life in April 2026; this installs the current Node 22 LTS.
NODE_VERSION=22.22.3

# Where nodeenv installs the local Node runtime.
NODEENV_DIR=.nodeenv

# Explicit npm executable path. Leave blank normally.
NPM_BINARY=

# Backend URL that the Vite dev server proxies /api and /auth to.
FLASK_BACKEND_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Attribution
# ---------------------------------------------------------------------------
# Served by GET /api/app-info and shown two ways: as clickable links in the app
# UI (login screen, guild rail, Settings > About Disclone) and as the bot's
# plain-text Discord custom status.
#
# Discord only lets a bot set an activity's name/state/type, and validates any
# `url` against twitch.tv and youtube.com — so a bot status can *name* the
# repository but can never carry a clickable link. That is why the links live
# in the app and the status is text.
#
# All of these are read per request, so changing one needs a redeploy, never a
# frontend rebuild.

# Display name used in the UI and at the front of the default status text.
APP_NAME=Disclone

# Shown on the About page. Defaults to the version in package.json at build
# time of the backend image; set it to keep them in step.
APP_VERSION=1.3.0

# Repository to promote. Must be http(s) with no userinfo — anything else (for
# example javascript: or https://github.com@evil.example/) is dropped rather
# than published, because these values become hrefs in the browser.
APP_GITHUB_URL=https://github.com/zexyomeme-svg/Discord-clone

# The live deployment. Resolution order:
#   1. this variable, if set
#   2. PUBLIC_BASE_URL — OAuth2 already requires that to be this service's
#      public address, so a fork gets a correct site URL for free instead of
#      advertising someone else's deployment
#   3. the Render service declared in render.yaml
APP_SITE_URL=https://discord-clone-render.onrender.com

# Leave blank to let the server compose "Name · repo · site" from the two URLs
# above, dropping the site when the result would exceed Discord's 96-character
# activity state limit. Set it to pin the exact text; that also makes the
# in-app status field read-only (presenceEditable: false).
APP_PRESENCE_TEXT=

# ---------------------------------------------------------------------------
# Discord OAuth2 login
# ---------------------------------------------------------------------------
# Create these at https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_SCOPES=identify email guilds

# REQUIRED for OAuth2: the public URL of your deployed app,
# for example https://your-app.onrender.com. Without it the server will not
# build a redirect URI from an untrusted request header and OAuth2 login fails
# closed with a 503 explaining what to set.
PUBLIC_BASE_URL=

# Optional explicit callback URL. Defaults to PUBLIC_BASE_URL/auth/discord/callback
DISCORD_REDIRECT_URI=

# Comma-separated hostnames whose X-Forwarded-Host may be used to build absolute
# URLs when PUBLIC_BASE_URL is unset. localhost/127.0.0.1 are always trusted so
# local development works without configuration.
TRUSTED_HOSTS=

# OAuth2 CSRF state cookie lifetime, in seconds.
OAUTH_STATE_MAX_AGE=600

# Lifetime of the signed one-time token handoff cookie, in seconds. The SPA
# collects it immediately after the redirect, so this can stay short.
OAUTH_HANDOFF_MAX_AGE=120
